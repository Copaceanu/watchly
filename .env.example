# Watchly — required credentials/config (set these as n8n credentials, NOT committed)

# LLMok (OpenAI-compatible gateway) — used for classification, vision, realism
# n8n credential type: Bearer Auth
LLMOK_ENDPOINT=https://burn.llmok.app/v1/chat/completions
LLMOK_MODEL=gpt-5.4-mini
LLMOK_API_KEY=

# WasenderAPI — WhatsApp send/receive
# n8n credential type: Bearer Auth. Key valid only while the WhatsApp session is Connected.
WASENDER_SEND_ENDPOINT=https://www.wasenderapi.com/api/send-message
WASENDER_API_KEY=
WASENDER_INBOUND_WEBHOOK=/webhook/watchly-inbound

# ScrapingBee — residential proxy + JS rendering to beat eMAG anti-bot (AWS WAF)
# n8n credential type: Query Auth (Name = api_key). Use premium_proxy=true & country_code=ro.
SCRAPINGBEE_API_KEY=

# Google Sheets — alert + price-history storage
# n8n credential type: Google Sheets OAuth2. Spreadsheet "Watchly" with tabs: alerts, price_history
GOOGLE_SHEET_ID=
